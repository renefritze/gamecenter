# Spotify Buzzer credentials (replace with values from the Spotify developer dashboard)
SPOTIFY_CLIENT_ID=dummy_spotify_client_id
SPOTIFY_CLIENT_SECRET=dummy_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Set to 1 to run the Spotify Buzzer without Spotify credentials or playback.
GAMECENTER_FAKE_SPOTIFY=0
